{
  "name": "hotkey-runbook",
  "version": "0.1.8",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:site": "vite --config vite.site.config.ts",
    "tauri": "tauri",
    "build": "npm run build:app && npm run build:site",
    "build:app": "tsc --noEmit && vite build",
    "build:site": "vite build --config vite.site.config.ts",
    "test": "npm run test:unit && npm run test:rust",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "lint": "tsc --noEmit && cargo fmt --manifest-path src-tauri/Cargo.toml -- --check && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --all-features -- -D warnings",
    "check": "npm test && npm run lint && npm run build"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "2.7.2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.58.2",
    "playwright-core": "1.58.2",
    "@types/node": "22.15.3",
    "typescript": "5.8.3",
    "vite": "6.4.3",
    "vitest": "3.2.7"
  },
  "engines": {
    "node": ">=20"
  }
}
