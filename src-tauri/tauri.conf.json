{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hotkey Runbook",
  "version": "0.1.8",
  "identifier": "in.sociobot.hotkey-runbook",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:app",
    "frontendDist": "../dist/app"
  },
  "app": {
    "windows": [
      {
        "title": "Hotkey Runbook",
        "width": 1180,
        "height": 760,
        "minWidth": 390,
        "minHeight": 620,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": { "csp": "default-src 'self'; img-src 'self' asset: data:; connect-src 'self' https://api.sociobot.in; style-src 'self' 'unsafe-inline'" }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Safe local runbooks at a keystroke",
    "longDescription": "Review typed parameters and exact process arguments before running local maintenance runbooks.",
    "copyright": "Copyright 2026 Param Factory",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "linux": { "deb": { "depends": [] }, "appimage": { "bundleMediaFramework": false } }
  }
}
